# ==============================================================================
# SLURBUILDS AI VAULT - Project 03: AI Research & Workflow Automation Agent
# Production Configuration Template
# ==============================================================================

# Application & Environment
APP_NAME="SLURBUILDS Research Agent"
APP_ENV="development"
DEBUG=true
PORT=8000

# Offline Demo Mode: operates without paid LLM/Search/LangSmith keys (mock LLM + fixtures)
DEMO_MODE=true

# Database: SQLite for local/offline testing, or PostgreSQL for production
# Local / test SQLite:
DATABASE_URL="sqlite+aiosqlite:///./research_agent.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/research_agent"

# Security & Authentication (Leave blank or set strong secret for production)
SECRET_KEY=""
ADMIN_API_KEY=""
DEFAULT_TEST_USER_KEY=""

# OpenAI-Compatible LLM Provider (Customer-provided, leave blank for DEMO_MODE)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"

# Search Provider (tavily, duckduckgo, mock)
SEARCH_PROVIDER="mock"
TAVILY_API_KEY=""

# LangSmith Observability & Tracing (Customer-provided, disabled by default)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="slurbuilds-research-agent"

# Online Sampled Evaluation (Optional, disabled by default)
ONLINE_EVAL_ENABLED=false
ONLINE_EVAL_SAMPLE_RATE=0.05
ONLINE_EVAL_COST_CAP_USD=5.0
EVAL_MAX_RUN_CASES=40

# Execution Budgets & Safety Controls
MAX_TOOL_CALLS_PER_TASK=15
MAX_SEARCH_RESULTS=5
FETCH_TIMEOUT_SECONDS=8
MAX_RETRIES_PER_STAGE=2
MAX_CONCURRENT_TOOL_CALLS=3
